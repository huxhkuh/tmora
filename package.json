{
  "name": "bou-time",
  "version": "1.5.5",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "desktop": "electron .",
    "build:windows": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "test:desktop": "node tests/desktop-smoke.mjs",
    "test:desktop:compact": "node tests/desktop-compact.mjs",
    "build:site": "node scripts/build-download-site.mjs",
    "test:site": "node tests/download-site.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "@playwright/test": "^1.55.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "main": "desktop/main.cjs",
  "description": "Hebrew personal project time tracker",
  "author": "Temura",
  "build": {
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "huxhkuh",
        "repo": "tmora",
        "releaseType": "release"
      }
    ],
    "appId": "il.bou.time",
    "productName": "תמורה",
    "directories": {
      "output": "../windows"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.txt",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "include": "desktop/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "תמורה",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "artifactName": "Bou-Time-${version}-x64-Setup.exe"
    },
    "portable": {
      "artifactName": "Bou-Time-${version}-x64-Portable.exe"
    },
    "executableName": "Bou Time",
    "electronLanguages": [
      "en-US",
      "en-GB",
      "he"
    ]
  },
  "homepage": "https://github.com/huxhkuh/tmora",
  "repository": {
    "type": "git",
    "url": "https://github.com/huxhkuh/tmora.git"
  }
}
